@page
@model IndexModel

<div class="container m-auto p-5">
    <div class="row h-100 p-5 justify-content-center align-items-center">
        <form method="post" asp-page="" asp-page-handler="">
            <div class="col-4 p-5 m-auto border border-primary border-2">
                <div class="row p-0 m-0 gap-0">
                    <label for="customer_id">Customer</label>
                    @{
                        var customerList = new SelectList(Model.Customers, "Id", "Name");
                    }
                    @Html.DropDownListFor(model => model.SelectedCustomer, customerList, "Select one...", htmlAttributes: new { @id = "customer_id", @name = "customer_id" })
                    <span asp-validation-for="SelectedCustomer"></span>
                </div>
                <div class="row py-2 px-0 m-0 justify-content-center">
                    <button type="submit" class="w-auto px-2 m-auto">Go To Shopping Cart</button>
                </div>
            </div>
        </form>
    </div>
</div>

